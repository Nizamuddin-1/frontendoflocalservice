# ─────────────────────────────────────────────────────────────────────────────
# LocalFix Expo App Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for the backend REST API
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Disable duplicate React Navigation container check warning if needed
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1

# Dev-only Auto-Login Configuration (NEVER runs in production)
# Set to 'true' to automatically authenticate on app launch without entering credentials
EXPO_PUBLIC_DEV_AUTO_LOGIN=true

# Initial role to auto-login as: 'consumer' or 'provider'
#   'consumer': logs in as nizamuddin@test.com
#   'provider': logs in as shamsuddin@test.com
EXPO_PUBLIC_DEV_AUTO_LOGIN_ROLE=consumer
